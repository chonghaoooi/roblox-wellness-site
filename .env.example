# Neon pooled connection string
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"
# 32+ random chars: openssl rand -base64 32
AUTH_SECRET="change-me"
# IANA timezone that defines "today" on the leaderboards
APP_TIMEZONE="Asia/Singapore"

# Optional AI: use a vision-capable model from an OpenAI-compatible API.
# Leave AI_BASE_URL and ANTHROPIC_API_KEY empty for manual logging.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# Alternative backend (used only when AI_BASE_URL is empty).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Generate once with web-push.generateVAPIDKeys(); keep the private key server-only.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://your-site.example"
# A random secret for authenticated Vercel Cron requests.
CRON_SECRET=""
# Shop top-ups (optional; use the verification token from your own Ko-fi API page)
KOFI_URL="https://ko-fi.com/your-page"
KOFI_VERIFICATION_TOKEN=""
