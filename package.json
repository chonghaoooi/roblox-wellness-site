{
  "name": "the-roblox-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "node --experimental-strip-types --test src/lib/calc.test.ts src/lib/lifts.test.ts src/lib/admin-validation.test.ts src/lib/push.test.ts src/lib/tracker.test.ts src/lib/reminders.test.ts src/lib/notification-prompt.test.ts src/lib/typing-space.test.ts src/lib/weight-classes.test.ts src/lib/shop.test.ts src/lib/validation.test.ts",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs",
    "mobile:sync": "cap sync && node scripts/configure-native-health.mjs",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:check": "node scripts/check-native-health.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capgo/capacitor-health": "^8.11.12",
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.3.0",
    "jose": "^6.2.12",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "description": "A community fitness tracker with meals, workouts, leaderboards, trends and mobile notifications.",
